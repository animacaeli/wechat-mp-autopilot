# 密钥环境变量（供 config.toml 的 *_env 字段引用）
# 也可以不用 .env：把值直接写进 config.toml 的对应字段（app_id / app_secret / api_key）
# 两者都配时以环境变量优先。本文件与 config.toml 一样被 gitignore。

# 微信公众号（后台「设置与开发 → 基本配置」）
WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=your-app-secret

# 大模型（任意 OpenAI 兼容端点的 API key，默认示例为 DeepSeek）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 配图（可选）：默认 provider=openverse 免 key，无需填写下面任何项
# 换用 pixabay：填 PIXABAY_API_KEY（pixabay.com/api/docs 免费注册）
# 换用 pexels：填 PEXELS_API_KEY（官方已暂停发放新 key，仅老用户可用）
# PIXABAY_API_KEY=
# PEXELS_API_KEY=

# 复制为 .env 并填写真实值（.env 已被 gitignore，不会进入仓库）
# config.toml 里的 *_env 字段引用的就是这里的变量名

# 微信公众号（后台「设置与开发 → 基本配置」）
WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=your-app-secret

# 大模型（任意 OpenAI 兼容端点的 API key，默认示例为 DeepSeek）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 配图（https://www.pexels.com/api/ 免费注册）
PEXELS_API_KEY=your-pexels-key
